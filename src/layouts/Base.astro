---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Loupe from '../components/Loupe.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title?: string;
	description?: string;
	/** Share preview under public/, drawn by scripts/og-images.py. */
	image?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image = '/og/home.png' } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<a class="skip" href="#main">본문으로 건너뛰기</a>
		<Loupe />
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/reveal';
		</script>
	</body>
</html>
