---
import Base from '../layouts/Base.astro';
---

<Base>
	<section class="placeholder">
		<h1>김용훈</h1>
		<p>포트폴리오를 준비하고 있습니다.</p>
	</section>
</Base>

<style>
	.placeholder {
		padding: 96px var(--pad) 0;
	}
	h1 {
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
	}
	p {
		margin-top: 24px;
		color: var(--ink-2);
	}
</style>
