---
import { getCollection, render } from 'astro:content';
import Hero from '../components/Hero.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import Raster from '../components/Raster.astro';
import Tag from '../components/Tag.astro';
import { profile } from '../data/profile';
import Base from '../layouts/Base.astro';
import { taskCount, taskGroups } from '../utils/project';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rows = await Promise.all(
	projects.map(async (project) => {
		const { id, data } = project;
		const groups = taskGroups((await render(project)).headings);
		return { id, title: data.title, tagline: data.tagline, period: data.period, groups, tasks: taskCount(groups) };
	}),
);
---

<Base>
	<Hero projectTitles={rows.map((row) => row.title)} />
	<Raster text="BACKEND" />
	<ProjectIndex rows={rows} />

	<section id="about" class="section">
		<h2 class="section-title">소개<span>ABOUT</span></h2>
		<div class="intro">
			{profile.intro.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<h3 class="sub label">Experience · {profile.experience.length}</h3>
		<ol class="experience">
			{
				profile.experience.map((job) => (
					<li>
						<div class="when">
							<p class="period">{job.period}</p>
							<p class="role">{job.role}</p>
						</div>
						<div>
							<h4>{job.company}</h4>
							<p class="about">{job.about}</p>
							<ul>
								{job.work.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ol>

		<h3 class="sub label">Skills · {profile.skills.length}</h3>
		<dl class="skills">
			{
				profile.skills.map(({ area, items }) => (
					<div>
						<dt>{area}</dt>
						<dd>{items}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section id="contact" class="section contact">
		<h2 class="section-title">연락<span>CONTACT</span></h2>
		<a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
		<div class="links">
			<Tag href={`mailto:${profile.email}`} prefix="@" label="email" />
			<Tag href={profile.github} label="github" />
		</div>
	</section>
</Base>

<style>
	.section {
		padding: 140px var(--pad) 0;
	}
	.intro {
		display: grid;
		gap: 16px;
		max-width: 760px;
		margin-top: 40px;
		color: var(--ink-2);
	}
	.sub {
		margin-top: 96px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
		font-weight: 400;
	}
	ol,
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.experience > li {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: var(--gutter);
		padding: 40px 0;
		border-bottom: 1px dashed var(--line);
	}
	.period {
		font-family: var(--font-mono);
		font-size: 15px;
	}
	.role {
		margin-top: 4px;
		font-size: 15px;
		color: var(--muted);
	}
	h4 {
		margin: 0;
		font-size: 24px;
		font-weight: 650;
		letter-spacing: -0.02em;
	}
	.about {
		margin-top: 6px;
		color: var(--muted);
		font-size: 15px;
	}
	.experience ul {
		display: grid;
		gap: 8px;
		margin-top: 18px;
	}
	.experience ul li {
		position: relative;
		padding-left: 22px;
		color: var(--ink-2);
	}
	.experience ul li::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.7em;
		width: 6px;
		height: 6px;
		border: 1px solid var(--ink);
	}
	.skills {
		margin: 0;
	}
	.skills div {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: var(--gutter);
		padding: 16px 0;
		border-bottom: 1px dashed var(--line);
	}
	.skills dt {
		font-size: 15px;
		color: var(--muted);
	}
	.skills dd {
		margin: 0;
	}
	.email {
		display: inline-block;
		margin-top: 40px;
		font-size: clamp(28px, 4.4vw, 64px);
		font-weight: 650;
		letter-spacing: -0.03em;
		line-height: 1.1;
		overflow-wrap: anywhere;
	}
	.email:hover {
		text-decoration: underline;
		text-underline-offset: 8px;
		text-decoration-thickness: 3px;
	}
	.links {
		display: flex;
		gap: 16px;
		margin-top: 32px;
	}

	@media (max-width: 720px) {
		.section {
			padding-top: 96px;
		}
		.experience > li,
		.skills div {
			grid-template-columns: 1fr;
			gap: 12px;
		}
		.sub {
			margin-top: 64px;
		}
	}
</style>
