---
import { getCollection, render } from 'astro:content';
import Tag from '../../components/Tag.astro';
import TaskIndex from '../../components/TaskIndex.astro';
import Base from '../../layouts/Base.astro';
import { formatPeriod, taskCount, taskGroups } from '../../utils/project';
import { url } from '../../utils/url';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, tagline, summary, company, role, period, stack, order } = project.data;
const { Content, headings } = await render(project);
const groups = taskGroups(headings);
---

<Base title={`${title} · ${tagline} | 김용훈`} description={summary}>
	<section class="hero">
		<div>
			<p class="kicker">
				<span class="chip">PROJECT {String(order).padStart(2, '0')}</span>
				<span>{title.toUpperCase()} · {taskCount(groups)} TASKS</span>
			</p>
			<h1>{tagline}</h1>
		</div>
		<p class="summary">{summary}</p>
	</section>

	<dl class="facts">
		<div><dt class="label">Company</dt><dd>{company}</dd></div>
		<div><dt class="label">Role</dt><dd>{role}</dd></div>
		<div><dt class="label">Period</dt><dd>{formatPeriod(period)}</dd></div>
		<div class="stack">
			<dt class="label">Stack</dt>
			<dd><ul>{stack.map((item) => <li>{item}</li>)}</ul></dd>
		</div>
	</dl>

	<div class="body">
		<article class="prose">
			<Content />
		</article>
		<aside>
			<TaskIndex groups={groups} />
		</aside>
	</div>

	<nav class="back" aria-label="프로젝트 이동">
		<Tag href={url('/#projects')} label="projects" />
	</nav>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr var(--aside);
		column-gap: var(--gutter);
		padding: 96px var(--pad) 0;
	}
	.kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		font-family: var(--font-mono);
		font-size: 16px;
		letter-spacing: 0.18em;
	}
	.chip {
		background: var(--ink);
		color: var(--paper);
		padding: 4px 12px;
	}
	h1 {
		margin-top: 18px;
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
	}
	.summary {
		align-self: end;
		color: var(--ink-2);
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(3, auto) 1fr;
		gap: 24px 48px;
		margin: 72px var(--pad) 0;
		padding: 20px 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.facts dd {
		margin: 6px 0 0;
	}
	.stack ul {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stack li {
		border: 1px dashed var(--ink);
		padding: 0 8px;
		font-size: 14px;
		line-height: 24px;
	}

	.body {
		display: grid;
		grid-template-columns: 1fr var(--aside);
		column-gap: var(--gutter);
		padding: 0 var(--pad);
	}
	aside {
		position: sticky;
		top: var(--header-h);
		align-self: start;
		margin-top: 96px;
	}

	.prose {
		max-width: 760px;
	}
	.prose :global(h2) {
		margin-top: 96px;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: var(--tracking-tight);
	}
	.prose :global(h3) {
		margin-top: 56px;
		font-size: 24px;
		font-weight: 650;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}
	.prose :global(ul) {
		display: grid;
		gap: 10px;
		margin: 20px 0 0;
		padding: 0;
		list-style: none;
	}
	.prose :global(li) {
		position: relative;
		padding-left: 22px;
		color: var(--ink-2);
	}
	.prose :global(li)::before {
		content: '';
		position: absolute;
		left: 2px;
		top: 0.7em;
		width: 6px;
		height: 6px;
		border: 1px solid var(--ink);
	}
	.prose :global(li:has(> strong)) {
		color: var(--ink);
	}
	.prose :global(li:has(> strong))::before {
		background: var(--ink);
	}
	.prose :global(strong) {
		font-weight: 650;
	}

	.back {
		padding: 96px var(--pad) 0;
	}

	@media (max-width: 960px) {
		.hero,
		.body {
			grid-template-columns: 1fr;
		}
		.summary {
			margin-top: 24px;
		}
		.facts {
			grid-template-columns: 1fr 1fr;
		}
		.stack {
			grid-column: 1 / -1;
		}
		aside {
			position: static;
			order: -1;
			margin-top: 56px;
		}
	}
	@media (max-width: 720px) {
		.hero {
			padding-top: 56px;
		}
		.kicker {
			font-size: 12px;
			gap: 10px;
			letter-spacing: 0.12em;
		}
		.prose :global(h2) {
			margin-top: 72px;
		}
		.prose :global(h3) {
			font-size: 20px;
		}
	}
</style>
