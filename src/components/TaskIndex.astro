---
import type { TaskGroup } from '../utils/project';

interface Props {
	groups: TaskGroup[];
}

const { groups } = Astro.props;
let number = 0;
---

<nav class="task-index" aria-label="과제 목차">
	<p class="head label"><span>Areas</span><span>Tasks</span></p>
	<ol class="areas">
		{
			groups.map(({ area, tasks }) => (
				<li>
					<a class="area" href={`#${area.slug}`}>
						{area.text}
						<span class="count">{tasks.length}</span>
					</a>
					<ol class="tasks">
						{tasks.map((task) => (
							<li>
								<a href={`#${task.slug}`}>
									<span class="num">{String(++number).padStart(2, '0')}</span>
									<span class="title">{task.text}</span>
								</a>
							</li>
						))}
					</ol>
				</li>
			))
		}
	</ol>
</nav>

<style>
	.head {
		display: flex;
		justify-content: space-between;
		padding-bottom: 12px;
		border-bottom: 1px solid var(--line);
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.areas {
		display: grid;
		gap: 20px;
		margin-top: 20px;
	}
	.area {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		font-size: 16px;
	}
	.count {
		font-family: var(--font-mono);
		font-size: var(--text-meta);
		color: var(--muted);
	}
	.tasks {
		display: grid;
		gap: 8px;
		margin-top: 10px;
	}
	.tasks a {
		display: grid;
		grid-template-columns: 24px 1fr;
		font-size: var(--text-meta);
		line-height: 1.45;
		color: var(--muted);
	}
	.num {
		font-family: var(--font-mono);
	}
	.title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	a:hover,
	a:hover .count,
	a[aria-current] {
		color: var(--ink);
	}
	/* The active task swaps its number for a filled square, the same marker as a result bullet. */
	.tasks a[aria-current] .num {
		position: relative;
		color: transparent;
	}
	.tasks a[aria-current] .num::before {
		content: '';
		position: absolute;
		left: 2px;
		top: calc(0.725em - 3px);
		width: 6px;
		height: 6px;
		background: var(--ink);
	}
</style>

<script>
	/*
	 * Mark the heading the reader is in: the last one whose top has passed under the sticky header.
	 * At the end of the page the last headings can never reach the header, so there the last visible one wins.
	 */
	const links = [...document.querySelectorAll<HTMLAnchorElement>('.task-index a[href^="#"]')];
	const targets = links
		.map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
		.filter((item): item is { link: HTMLAnchorElement; heading: HTMLElement } => item.heading !== null);
	const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) + 24 || 124;
	let queued = false;

	function update() {
		queued = false;
		const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
		const line = atEnd ? innerHeight : offset;
		let current: (typeof targets)[number] | undefined;
		for (const target of targets) {
			if (target.heading.getBoundingClientRect().top <= line) current = target;
		}
		const area = current?.link.closest('.areas > li')?.querySelector<HTMLAnchorElement>('.area');
		for (const { link } of targets) {
			if (link === current?.link || link === area) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		}
	}

	addEventListener(
		'scroll',
		() => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(update);
		},
		{ passive: true },
	);
	update();
</script>
