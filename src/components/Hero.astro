---
import { profile } from '../data/profile';
import { url } from '../utils/url';

interface Props {
	projectTitles: string[];
}

const { projectTitles } = Astro.props;
const { headline, summary } = profile;
---

<section class="hero">
	<div>
		<p class="kicker"><span class="chip">PYTHON BACKEND</span><span>{headline.lead}</span></p>
		<h1>{headline.title[0]}<br />{headline.title[1]}</h1>
	</div>
	<p class="summary">{summary}</p>
	<a class="cta" href={url('/#projects')}>
		<span class="field"><b>/projects</b><span>{projectTitles.join(' · ')}</span></span>
		<span class="button"><i></i><span>프로젝트 보기</span></span>
	</a>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr var(--aside);
		column-gap: var(--gutter);
		padding: 96px var(--pad) 0;
	}
	.kicker {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
		font-size: 17px;
		font-weight: 500;
	}
	.chip {
		background: var(--ink);
		color: var(--paper);
		padding: 4px 12px;
		font-family: var(--font-mono);
		font-size: 16px;
		font-weight: 400;
		letter-spacing: 0.18em;
	}
	h1 {
		margin-top: 18px;
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
	}
	.summary {
		align-self: end;
		color: var(--ink-2);
	}
	.cta {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: 1fr var(--aside);
		column-gap: var(--gutter);
		margin-top: 72px;
	}
	.field {
		display: flex;
		align-items: center;
		border-bottom: 1px solid var(--line);
		min-width: 0;
	}
	.field b {
		font-family: var(--font-mono);
		font-weight: 400;
		background: var(--ink);
		color: var(--paper);
		padding: 12px;
	}
	.field span {
		padding: 0 12px;
		color: var(--muted);
		font-size: 18px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.button {
		display: flex;
		gap: 4px;
		min-height: 48px;
	}
	.button i {
		width: 16px;
		background: var(--ink);
	}
	.button span {
		flex: 1;
		display: grid;
		place-items: center;
		background: var(--ink);
		color: var(--paper);
		font-weight: 600;
	}
	.cta:hover .field span {
		color: var(--ink);
	}

	@media (max-width: 960px) {
		.hero,
		.cta {
			grid-template-columns: 1fr;
		}
		.summary {
			margin-top: 24px;
		}
		.button {
			margin-top: 16px;
		}
	}
	@media (max-width: 720px) {
		.hero {
			padding-top: 56px;
		}
		.kicker {
			gap: 10px;
			font-size: 15px;
		}
		.chip {
			font-size: 12px;
			letter-spacing: 0.12em;
		}
		.cta {
			margin-top: 40px;
		}
	}
</style>
